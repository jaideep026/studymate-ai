PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studymate
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
# Optional: separate password for the /admin stats dashboard.
# If unset, JWT_SECRET is used as the admin key instead.
ADMIN_KEY=replace-with-a-separate-admin-password
