{
  "name": "studymate-ai-backend",
  "version": "1.0.0",
  "description": "AI-powered study assistant backend - REST API with JWT auth, MongoDB, and a Gemini-based RAG chat over uploaded notes (text, PDF, PPTX, DOCX).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "multer": "^2.2.0",
    "officeparser": "^7.8.0",
    "openai": "^4.55.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
